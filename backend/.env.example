SECRET_KEY=generate-a-random-secret
JWT_SECRET_KEY=generate-a-separate-random-secret
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
DATABASE_URL=postgresql://user:password@localhost:5432/land_registry

# Hyperledger Fabric blockchain gateway configuration (optional).
# Leave unset to use the unavailable gateway (no blockchain integration).
# FABRIC_CONNECTION_PROFILE=/path/to/connection-profile.json
# FABRIC_CHANNEL=mychannel
# FABRIC_CHAINCODE_NAME=land-registry
# FABRIC_USER=registrar1
# FABRIC_WALLET_PATH=/path/to/wallet
